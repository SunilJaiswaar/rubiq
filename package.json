{
  "name": "rubiq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rubiq — a free, open-source, GitHub-first platform for learning software engineering from zero to professional.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "content:build": "node scripts/build-content.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "new:lesson": "node scripts/new.mjs lesson",
    "new:module": "node scripts/new.mjs module",
    "new:track": "node scripts/new.mjs track",
    "dev": "npm run content:build && vite",
    "build": "npm run content:validate && npm run content:build && tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "build:pages": "BASE_PATH=/rubiq/ npm run build",
    "preview:pages": "BASE_PATH=/rubiq/ vite preview",
    "typecheck": "npm run content:build && tsc -b --noEmit false --emitDeclarationOnly false",
    "lint": "eslint .",
    "test": "npm run content:build && vitest run",
    "test:smoke": "node --experimental-websocket scripts/smoke.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.4",
    "markdown-it": "^14.3.2",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-container": "^4.0.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sucrase": "^3.35.1"
  }
}
