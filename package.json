{
  "name": "rubiq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rubiq \u2014 a free, open-source, GitHub-first platform for learning software engineering from zero to professional.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "content:build": "node scripts/build-content.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "new:lesson": "node scripts/new.mjs lesson",
    "new:module": "node scripts/new.mjs module",
    "new:track": "node scripts/new.mjs track",
    "dev": "npm run content:build && vite",
    "build": "npm run content:validate && npm run content:build && tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "build:pages": "BASE_PATH=/rubiq/ npm run build",
    "preview:pages": "BASE_PATH=/rubiq/ vite preview",
    "typecheck": "npm run content:build && tsc -b --noEmit false --emitDeclarationOnly false",
    "lint": "eslint .",
    "test": "npm run content:build && vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "test:watch": "vitest",
    "content:fences": "node scripts/check-ruby-fences.mjs",
    "content:exercises": "ruby scripts/check-exercises.rb"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "js-yaml": "^5.4.3",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@ruby/3.4-wasm-wasi": "^2.10.1",
    "@ruby/wasm-wasi": "^2.10.1",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.4",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-container": "^4.0.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sucrase": "^3.35.1"
  },
  "_overridesNote": "dompurify: monaco-editor 0.57 pins dompurify 3.4.15 exactly, and <=3.4.15 carries two DOM XSS advisories (GHSA-p98j-92pf-mc4p, GHSA-6688-9rhm-gjv2). 3.4.16 is the patch. Both are low severity and not reachable here \u2014 Monaco sanitises its own hover markdown, and this app has no user-generated content shared between visitors \u2014 but there is no reason to ship a known-vulnerable transitive dep when the fix is a patch bump. Remove this once monaco bumps its own pin.",
  "overrides": {
    "dompurify": "^3.4.16"
  }
}
